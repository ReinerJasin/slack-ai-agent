### Project Setting ###
PORT=3000   # Unused (currently using default port for FastAPI)
NODE_ENV=development

### PostgreSQL Database ###
DATABASE_URL=postgresql://username:password@localhost:5432/slack_ai_agent

### Slack Configuration ###
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token     # From Slack API
SLACK_SIGNING_SECRET=your-slack-signing-secret     # From Slack API
SLACK_PRIVATE_CHANNEL_ID=C0123456789     # From Slack App Channel Setting

### OpenAI Model Key ###
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

### Company Information (for AI analysis) ###
COMPANY_NAME=Rei Technologies Inc.
COMPANY_PRODUCT=Smart agentic AI products